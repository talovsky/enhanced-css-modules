{
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "Bundler",
		"target": "esnext",
		"lib": ["esnext"],
		"types": ["node", "vscode"],
		"sourceMap": true,
		"rootDir": "src",
		"noEmit": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": false /* enable all strict type-checking options */,
		"noFallthroughCasesInSwitch": true
	},
	"exclude": ["node_modules", ".vscode-test", "out", "src/test/fixtures"],
	"include": ["src/**/*.ts"]
}
